PKG

cat > jest.config.cjs <<'JEST'
module.exports = {
  testEnvironment: 'jsdom',
};
JEST

mkdir -p tests/frontend
cat > tests/frontend/app.test.js <<'TEST'
/**
 * @jest-environment jsdom
 */

const fs = require('fs');
const path = require('path');

describe('app.js basic functions', () => {
  let appJs;
  beforeAll(() => {
    const code = fs.readFileSync(path.resolve(__dirname, '../../app.js'), 'utf8');
    // Evaluate in JSDOM context
    const script = `(function(){ ${code}; return window.ShieldVisionAI; })()`;
    const fn = new Function('window', script);
    global.window = global.window || {};
    const result = fn(global.window);
    appJs = result;
  });

  test('exports expected functions', () => {
    expect(appJs).toHaveProperty('logEvent');
    expect(appJs).toHaveProperty('drawGlobe');
    expect(typeof appJs.handleCopilotSubmit).toBe('function');
  });
});
TEST

echo "Staging changes..."
git add .

echo "Committing..."
git commit -m "chore: add backend skeleton, docker-compose, migrations, CI workflows, frontend tests, env example"

echo "Pushing to origin/${branch}..."
git push --set-upstream origin "${branch}"

echo "Done. Branch ${branch} pushed to origin. Use 'gh pr create' or GitHub UI to open a PR."
