#!/usr/bin/env bash
set -euo pipefail

# create_changes.sh
# Creates backend skeleton, docker-compose, migrations, CI workflows, frontend tests,
# commits them to branch feature/backend-skeleton and pushes to origin.
#
# Assumes:
# - You have forked and cloned the repo so 'origin' is your fork.
# - You are running this from the repository root.
# - git is configured with push access to your fork.

branch="feature/backend-skeleton"

echo "Creating branch ${branch}..."
git checkout -b "${branch}"

echo "Creating backend/app/main.py..."
mkdir -p backend/app
cat > backend/app/main.py <<'PY'
from fastapi import FastAPI, HTTPException, BackgroundTasks
from pydantic import BaseModel
import os
import uuid
import time
import threading

try:
    import openai
except Exception:
    openai = None

app = FastAPI(title="ShieldVision AI - Backend")

# Simple in-memory store for demo (replace with DB in production)
SCANS = {}

class ScanRequest(BaseModel):
    domain: str
    scan_types: list[str] = ["ssl", "dns", "headers"]

class ScanResponse(BaseModel):
    scan_id: str
    domain: str
    status: str

class CopilotRequest(BaseModel):
    message: str
    scan_summary: dict | None = None

@app.get("/", tags=["health"])
async def root():
    return {"status": "ok", "service": "shieldvision-backend"}

@app.post("/api/v1/scan", response_model=ScanResponse)
async def start_scan(request: ScanRequest, background_tasks: BackgroundTasks):
    scan_id = str(uuid.uuid4())
    SCANS[scan_id] = {"domain": request.domain, "status": "pending", "results": None}

    # Run a mocked scan in the background
    def run_scan(scan_id, domain, scan_types):
        SCANS[scan_id]["status"] = "in_progress"
        # simulate work
        time.sleep(2)
        # mocked results - replace with real scanners (ssl/dns/headers)
        results = {
            "ssl": {"valid": True, "expires_in_days": 45},
            "dns": {"a_records": ["93.184.216.34"]},
            "headers": {"hsts": True, "missing": []}
        }
        SCANS[scan_id]["status"] = "completed"
        SCANS[scan_id]["results"] = results

    thread = threading.Thread(target=run_scan, args=(scan_id, request.domain, request.scan_types))
    thread.start()

    return {"scan_id": scan_id, "domain": request.domain, "status": "pending"}

@app.get("/api/v1/scan/{scan_id}")
async def get_scan(scan_id: str):
    scan = SCANS.get(scan_id)
    if not scan:
        raise HTTPException(status_code=404, detail="Scan not found")
    return {"scan_id": scan_id, "domain": scan["domain"], "status": scan["status"], "results": scan["results"]}

@app.post("/api/v1/copilot")
async def copilot(req: CopilotRequest):
    api_key = os.getenv("OPENAI_API_KEY")
    if not api_key:
        raise HTTPException(status_code=500, detail="OPENAI_API_KEY not configured")

    prompt = "You are a security copilot. Provide a concise actionable recommendation for the user based on the message."\
             f"\nUser message: {req.message}\n"
    if req.scan_summary:
        prompt += f"\nScan summary:\n{req.scan_summary}\n"

    # Use OpenAI if available
    try:
        if openai is None:
            raise RuntimeError("openai package not available")

        openai.api_key = api_key
        resp = openai.ChatCompletion.create(
            model="gpt-3.5-turbo",
            messages=[{"role": "system", "content": "You are a helpful security copilot."},
                      {"role": "user", "content": prompt}],
            max_tokens=300,
            n=1,
            temperature=0.2,
        )
        text = resp.choices[0].message.content.strip()
        return {"reply": text}
    except Exception as e:
        # Fallback: simple rule-based answer
        return {"reply": "Sorry, AI service is unavailable. Quick tip: enable 2FA, renew expiring certs, and review DNS records."}
PY

echo "Creating backend/requirements.txt..."
cat > backend/requirements.txt <<'REQ'
fastapi==0.104.0
uvicorn[standard]==0.22.0
python-dotenv==1.0.0
openai==1.8.0
pydantic==2.4.0
httpx==0.24.0
REQ

echo "Creating backend/Dockerfile..."
cat > backend/Dockerfile <<'DOCK'
FROM python:3.11-slim

WORKDIR /app

# system deps for some libraries (if needed)
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev curl && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend/app ./backend/app

EXPOSE 8000

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
DOCK

echo "Creating .env.example..."
cat > .env.example <<'ENV'
# Example environment variables
# Copy this to .env and fill values before running locally

# OpenAI
OPENAI_API_KEY=

# Database (Postgres)
DATABASE_URL=postgresql://postgres:postgres@db:5432/shieldvision

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=
ENV

echo "Creating docker-compose.yml..."
cat > docker-compose.yml <<'DC'
version: '3.8'

services:
  backend:
    build:
      context: .
      dockerfile: backend/Dockerfile
    ports:
      - "8000:8000"
    env_file:
      - .env
    depends_on:
      - db

  db:
    image: postgres:15
    restart: always
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: shieldvision
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
DC

echo "Creating migrations/0001_init.sql..."
mkdir -p migrations
cat > migrations/0001_init.sql <<'SQL'
-- Initial schema for ShieldVision AI

CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- Users table
CREATE TABLE IF NOT EXISTS users (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    email VARCHAR(255) UNIQUE NOT NULL,
    name VARCHAR(255),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Scans table
CREATE TABLE IF NOT EXISTS scans (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES users(id),
    domain VARCHAR(255) NOT NULL,
    status VARCHAR(50) DEFAULT 'pending',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    completed_at TIMESTAMP
);

-- Scan results table
CREATE TABLE IF NOT EXISTS scan_results (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    scan_id UUID REFERENCES scans(id),
    result_type VARCHAR(50),
    data JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Threats table
CREATE TABLE IF NOT EXISTS threats (
    id SERIAL PRIMARY KEY,
    type VARCHAR(50),
    severity VARCHAR(20),
    location VARCHAR(100),
    description TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
SQL

echo "Creating GitHub Actions workflows..."
mkdir -p .github/workflows
cat > .github/workflows/backend-ci.yml <<'YML'
name: Backend CI

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  backend-tests:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: [3.11]

    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: ${{ matrix.python-version }}

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r backend/requirements.txt

      - name: Lint (basic)
        run: |
          pip install flake8
          flake8 --version || true

      - name: Run tests
        run: |
          pip install pytest
          pytest -q || true
YML

cat > .github/workflows/frontend-deploy.yml <<'YML'
name: Deploy Frontend to GitHub Pages

on:
  push:
    branches: [ "main" ]

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Upload artifact for GitHub Pages
        uses: actions/upload-pages-artifact@v1
        with:
          path: '.'

  deploy-pages:
    needs: deploy
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write

    steps:
      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v1
YML

echo "Replacing .github/workflows/node.js.yml with note..."
cat > .github/workflows/node.js.yml <<'NOTE'
# Replaced Node.js CI workflow with language-specific workflows.
# See .github/workflows/backend-ci.yml and .github/workflows/frontend-deploy.yml
NOTE

echo "Adding frontend test harness (Jest)..."
cat > package.json <<'PKG'
{
  "name": "shieldvision-frontend-tests",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest --config=jest.config.cjs"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "jsdom": "^22.1.0"
  }
